{
  "extends": "@achra/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@/shared/*": ["./modules/shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "svgr.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "modules/__generated__"]
}
